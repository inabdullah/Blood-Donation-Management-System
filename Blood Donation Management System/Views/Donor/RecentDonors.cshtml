@{
}

@model List<Blood_Donation_Management_System.EF.Tables.Donor>

<h1>Recent Donors</h1>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Blood Group</th>
        <th>Contact</th>
        <th>City</th>
        <th>Last Donation Date</th>
    </tr>

    @foreach (var d in Model)
    {
        <tr>
            <td>@d.DonorId</td>
            <td>@d.FullName</td>
            <td>@d.BloodGroup</td>
            <td>@d.ContactNo</td>
            <td>@d.City</td>
            <td>@d.LastDonationDate</td>
        </tr>
    }

</table>
