@{
}
@model Blood_Donation_Management_System.EF.Tables.Donor

@{
    ViewData["Title"] = "Edit Donor";
}

<h2>Edit Donor</h2>

<form method="post">

    <input type="hidden" name="DonorId" value="@Model.DonorId" />

    Name:<br />
    <input type="text" name="FullName" value="@Model.FullName" class="form-control" />
    <br />

    Blood Group:<br />
    <input type="text" name="BloodGroup" value="@Model.BloodGroup" class="form-control" />
    <br />

    Contact No:<br />
    <input type="text" name="ContactNo" value="@Model.ContactNo" class="form-control" />
    <br />

    City:<br />
    <input type="text" name="City" value="@Model.City" class="form-control" />
    <br />

    Last Donation Date:<br />
    <input type="date"
           name="LastDonationDate"
           value="@Model.LastDonationDate.ToString("yyyy-MM-dd")"
           class="form-control" />
    <br />

    <input type="submit" value="Update" class="btn btn-success" />
    <a href="/Donor/Index">Back</a>

</form>